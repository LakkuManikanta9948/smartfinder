<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f7fb" />
    <title>@ViewData["Title"] — SmartCompare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/search-suggestions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartDealFinder.UI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-premium.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="main-nav" aria-label="Main navigation">
            <a class="brand-lockup" asp-controller="Home" asp-action="Index"><span class="brand-mark">SC</span><span>SmartCompare<small>SHOP WITH CLARITY</small></span></a>
            <button class="menu-toggle" type="button" data-menu-toggle aria-controls="primary-links" aria-expanded="false" aria-label="Open navigation">☰</button>
            <div class="nav-links" id="primary-links"><a asp-controller="Home" asp-action="Index">Discover</a><a asp-controller="Storefront" asp-action="Index">Products</a><a asp-controller="Home" asp-action="Index" asp-fragment="categories">Categories</a><a asp-controller="Home" asp-action="Index" asp-fragment="compare">Compare</a><a asp-controller="Home" asp-action="Privacy">How it works</a></div>
            <div class="nav-actions">
                <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false"><span data-theme-icon aria-hidden="true">◐</span></button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("ORGADMIN")) { <a class="nav-admin-link" asp-controller="AdminDashboard" asp-action="Index">Control center</a> }
                    <a class="nav-admin-link" asp-controller="UserDashboard" asp-action="Index">My account</a>
                    <span class="nav-user">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-nav">Sign out</button></form>
                }
                else
                {
                    <a class="btn btn-nav" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </div>
        </nav>
    </header>
    <main class="site-main">
        @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
        @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="footer-inner"><a class="brand-lockup" asp-controller="Home" asp-action="Index"><span class="brand-mark">SC</span><span>SmartCompare<small>SMARTER SHOPPING, MADE SIMPLE</small></span></a><p>We show verified offers clearly and label sample information honestly.</p><a asp-controller="Home" asp-action="Privacy">Privacy & data</a><span>© @DateTime.UtcNow.Year SmartCompare</span></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/premium.js" asp-append-version="true"></script>
    <script src="~/js/search-suggestions.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

