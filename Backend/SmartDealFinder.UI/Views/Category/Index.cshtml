@using SmartDealFinder.Models.DTO
@model IEnumerable<CategoryListItem>
@{
    ViewData["Title"] = "Categories";
}
<div class="container mt-4">
    <h1>Categories</h1>
    <a class="btn btn-primary mb-3" asp-action="Save">Create New</a>
    <table class="table table-striped table-bordered">
        <thead><tr><th>Name</th><th>Slug</th><th>Active</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Slug ?? "-")</td>
                    <td>@(item.Active ? "Yes" : "No")</td>
                    <td><a class="btn btn-warning btn-sm" asp-action="Save" asp-route-id="@item.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
