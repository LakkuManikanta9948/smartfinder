@model RequestOtpInput
@{
    ViewData["Title"] = "Sign in";
}
<section class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow">WELCOME TO SMARTCOMPARE</p>
        <h1>Sign in to SmartCompare</h1>
        <p class="muted">Continue with Google, sign in with your admin password, or verify your phone. New accounts are standard users.</p>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }
        @if (ViewData["GoogleSignInPending"] is true)
        {
            <div class="alert alert-info" role="status">Verify your phone number to securely link it to your Google account.</div>
        }
        @if (ViewData["GoogleLoginEnabled"] is true)
        {
            <form asp-action="ExternalLogin" method="post">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-dark w-100 py-2"><span aria-hidden="true">G</span> Continue with Google</button>
            </form>
            <div class="auth-divider"><span>or continue with phone</span></div>
        }
        else
        {
            <button type="button" class="btn btn-outline-dark w-100 py-2" disabled title="Configure Google OAuth client credentials to enable this option."><span aria-hidden="true">G</span> Continue with Google</button>
            <p class="auth-note">Google sign-in requires OAuth client credentials. Password and phone OTP sign-in remain available.</p>
        }
        <form asp-action="PasswordLogin" method="post" class="mt-3">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <label class="form-label" for="adminEmail">Email</label>
            <input class="form-control" id="adminEmail" name="Email" type="email" autocomplete="username" required />
            <label class="form-label mt-3" for="adminPassword">Password</label>
            <input class="form-control" id="adminPassword" name="Password" type="password" autocomplete="current-password" required />
            <button type="submit" class="btn btn-outline-brand w-100 mt-3">Sign in with email</button>
        </form>
        <div class="auth-divider"><span>or verify your phone</span></div>
        <form asp-action="RequestCode" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <label asp-for="PhoneNumber" class="form-label">Phone number</label>
            <input asp-for="PhoneNumber" class="form-control form-control-lg" autocomplete="tel" placeholder="+14155552671" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            <label asp-for="DisplayName" class="form-label mt-3">Name <span class="muted">(for new accounts)</span></label>
            <input asp-for="DisplayName" class="form-control" autocomplete="name" placeholder="Your name" />
            <button type="submit" class="btn btn-brand w-100 mt-4">Send verification code <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-note">By continuing, you agree to our <a asp-controller="Home" asp-action="Privacy">privacy policy</a>.</p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
