@model RolePermissionEditorViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Role permission management";
}
<div class="admin-title"><div><p class="eyebrow">ROLE ACCESS</p><h1>Role permissions</h1><p class="muted">Grant module access to every member of an application role. User-specific denials take precedence.</p></div></div>
<section class="admin-panel permission-picker"><form asp-action="Index" method="get"><label class="form-label" for="roleId">Select a role</label><select class="form-select" id="roleId" name="roleId" data-auto-submit><option value="">Choose a role</option>@foreach (var role in Model.Roles) { <option value="@role.Id" selected="@(Model.RoleId == role.Id ? "selected" : null)">@role.Label</option> }</select></form><p class="muted mb-0">ORGADMIN is intentionally excluded from role permission editing and remains protected.</p></section>
@if (!string.IsNullOrEmpty(Model.RoleId))
{
    <form asp-action="Save" method="post" class="admin-panel role-permission-form">
        <input asp-for="RoleId" type="hidden" />
        <div class="permission-header"><div><p class="eyebrow">ROLE ACCESS MATRIX</p><h2>@Model.RoleName</h2></div><button class="btn btn-brand" type="submit">Save role permissions</button></div>
        <div class="permission-table-wrap"><table class="permission-table"><thead><tr><th>Application module</th><th>Permission code</th><th>Allow role</th></tr></thead><tbody>
        @for (var index = 0; index < Model.Permissions.Count; index++)
        {
            <tr><td>@Model.Permissions[index].Label.Split(' ')[0]</td><td><code>@Model.Permissions[index].Code</code></td><td><input asp-for="Permissions[index].IsGranted" class="form-check-input" aria-label="Allow role @Model.Permissions[index].Code" /><input asp-for="Permissions[index].Code" type="hidden" /><input asp-for="Permissions[index].Label" type="hidden" /></td></tr>
        }
        </tbody></table></div>
    </form>
}
