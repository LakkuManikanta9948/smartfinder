@using SmartDealFinder.Domain.Entities
@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}
<div class="container mt-4">
    <h1>Categories</h1>
    <a class="btn btn-primary mb-3" asp-action="Create">Create New</a>
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Icon Class</th>
                <th>Parent</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Slug)</td>
                    <td>@Html.DisplayFor(modelItem => item.IconClass)</td>
                    <td>@(item.ParentId.HasValue ? item.ParentId.ToString() : "-")</td>
                    <td>@(item.Active ? "Yes" : "No")</td>
                    <td>
                        <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>