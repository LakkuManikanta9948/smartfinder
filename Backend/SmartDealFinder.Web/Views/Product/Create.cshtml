@using SmartDealFinder.Domain.Entities
@model Product
@{
    ViewData["Title"] = "Create Product";
}
<div class="container mt-4">
    <h1>Create Product</h1>
    <form method="post" asp-action="Create">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Title"></label>
                    <input class="form-control" asp-for="Title" />
                    <span class="text-danger" asp-validation-for="Title"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CategoryId"></label>
                    <select class="form-control" asp-for="CategoryId" asp-items="ViewBag.Categories">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span class="text-danger" asp-validation-for="CategoryId"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MerchantId"></label>
                    <select class="form-control" asp-for="MerchantId" asp-items="ViewBag.Merchants">
                        <option value="">-- Select Merchant --</option>
                    </select>
                    <span class="text-danger" asp-validation-for="MerchantId"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Currency"></label>
                    <input class="form-control" asp-for="Currency" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CurrentPrice"></label>
                    <input class="form-control" asp-for="CurrentPrice" />
                    <span class="text-danger" asp-validation-for="CurrentPrice"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="OriginalPrice"></label>
                    <input class="form-control" asp-for="OriginalPrice" />
                    <span class="text-danger" asp-validation-for="OriginalPrice"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="DiscountPercent"></label>
                    <input class="form-control" asp-for="DiscountPercent" />
                    <span class="text-danger" asp-validation-for="DiscountPercent"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Active" /> <label class="form-check-label" asp-for="Active">Active</label>
                </div>
            </div>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Description"></label>
            <textarea class="form-control" asp-for="Description"></textarea>
        </div>
        <div class="form-group mb-3">
            <label asp-for="ImageUrl"></label>
            <input class="form-control" asp-for="ImageUrl" />
        </div>
        <div class="form-group mb-3">
            <button class="btn btn-primary" type="submit">Create</button>
            <a class="btn btn-secondary" asp-action="Index">Back to List</a>
        </div>
    </form>
</div>