@using SmartDealFinder.Domain.Entities
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}
<div class="container mt-4">
    <h1>Products</h1>
    <a class="btn btn-primary mb-3" asp-action="Create">Create New</a>
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Merchant</th>
                <th>Current Price</th>
                <th>Original Price</th>
                <th>Discount</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@(item.Category != null ? item.Category.Name : "N/A")</td>
                    <td>@(item.Merchant != null ? item.Merchant.Name : "N/A")</td>
                    <td>@String.Format("{0:N2}", item.CurrentPrice) @item.Currency</td>
                    <td>@(item.OriginalPrice.HasValue ? String.Format("{0:N2}", item.OriginalPrice.Value) : "-")</td>
                    <td>@(item.DiscountPercent.HasValue ? item.DiscountPercent.Value.ToString("F2") + "%" : "-")</td>
                    <td>@(item.Active ? "Yes" : "No")</td>
                    <td>
                        <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>