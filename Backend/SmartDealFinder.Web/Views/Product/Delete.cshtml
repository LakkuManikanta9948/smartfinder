@using SmartDealFinder.Domain.Entities
@model Product
@{
    ViewData["Title"] = "Delete Product";
}
<div class="container mt-4">
    <h1>Delete Product</h1>
    <h3>Are you sure you want to delete this product?</h3>
    <div class="card">
        <div class="card-body">
            <p><strong>Title:</strong> @Model.Title</p>
            <p><strong>Category:</strong> @(Model.Category != null ? Model.Category.Name : "N/A")</p>
            <p><strong>Merchant:</strong> @(Model.Merchant != null ? Model.Merchant.Name : "N/A")</p>
            <p><strong>Current Price:</strong> @String.Format("{0:N2}", Model.CurrentPrice) @Model.Currency</p>
        </div>
    </div>
    <form method="post" asp-action="DeleteConfirmed" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger" type="submit">Delete</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </form>
</div>