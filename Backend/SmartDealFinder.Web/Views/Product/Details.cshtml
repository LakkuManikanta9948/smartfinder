@using SmartDealFinder.Domain.Entities
@model Product
@{
    ViewData["Title"] = "Product Details";
}
<div class="container mt-4">
    <h1>Product Details</h1>
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@(Model.Category != null ? Model.Category.Name : "N/A")</dd>
                <dt class="col-sm-3">Merchant</dt>
                <dd class="col-sm-9">@(Model.Merchant != null ? Model.Merchant.Name : "N/A")</dd>
                <dt class="col-sm-3">Current Price</dt>
                <dd class="col-sm-9">@String.Format("{0:N2}", Model.CurrentPrice) @Model.Currency</dd>
                <dt class="col-sm-3">Original Price</dt>
                <dd class="col-sm-9">@(Model.OriginalPrice.HasValue ? String.Format("{0:N2}", Model.OriginalPrice.Value) : "-")</dd>
                <dt class="col-sm-3">Discount Percent</dt>
                <dd class="col-sm-9">@(Model.DiscountPercent.HasValue ? Model.DiscountPercent.Value.ToString("F2") + "%" : "-")</dd>
                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">@(Model.Active ? "Yes" : "No")</dd>
                <dt class="col-sm-3">Featured</dt>
                <dd class="col-sm-9">@(Model.Featured ? "Yes" : "No")</dd>
                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
            </dl>
        </div>
    </div>
    <a class="btn btn-secondary" asp-action="Edit">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>